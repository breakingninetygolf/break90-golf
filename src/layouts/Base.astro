---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props {
 title?: string; description?: string; image?: string; imageAlt?: string;
 type?: 'website' | 'article'; published?: string; modified?: string;
 noindex?: boolean; structuredData?: Record<string, unknown>[];
}
const {
 title='How to Break 90: Golf Tips, Courses & Gear | Break 90 Golf',
 description='Play smarter golf with practical tips, simple scoring strategy, public golf course guides and useful gear recommendations for golfers chasing 89.',
 image='/images/share-preview.png', imageAlt='Break 90 Golf — Less Thinking. Better Golf.',
 type='website', published, modified, noindex=false, structuredData=[]
}=Astro.props;
const site=Astro.site || new URL('https://breakingninetygolf.com');
const canonical=new URL(Astro.url.pathname,site);
const shareImage=new URL(image,site);
const graph=[
 {'@type':'Organization','@id':new URL('/#organization',site).href,name:'Break 90 Golf',url:site.href,logo:{'@type':'ImageObject',url:new URL('/site-icon.png',site).href,width:512,height:512}},
 {'@type':'WebSite','@id':new URL('/#website',site).href,url:site.href,name:'Break 90 Golf',alternateName:'Breaking Ninety Golf',inLanguage:'en-US',publisher:{'@id':new URL('/#organization',site).href}},
 {'@type':'WebPage','@id':canonical.href+'#webpage',url:canonical.href,name:title,description,inLanguage:'en-US',isPartOf:{'@id':new URL('/#website',site).href}},
 ...structuredData
];
const json=JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B7CP6JTGSL"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-B7CP6JTGSL', {
      allow_google_signals: false,
      allow_ad_personalization_signals: false
    });
  </script>
  <meta name="theme-color" content="#141b17"/><meta name="description" content={description}/>
  <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'}/>
  <link rel="canonical" href={canonical}/><title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <meta property="og:type" content={type}/><meta property="og:locale" content="en_US"/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
  <meta property="og:site_name" content="Break 90 Golf"/><meta property="og:url" content={canonical}/>
  <meta property="og:image" content={shareImage}/><meta property="og:image:type" content="image/png"/>
  <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
  <meta property="og:image:alt" content={imageAlt}/>
  {published && <meta property="article:published_time" content={published}/>}
  {modified && <meta property="article:modified_time" content={modified}/>}
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/><meta name="twitter:image" content={shareImage}/>
  <meta name="twitter:image:alt" content={imageAlt}/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/>
  <link rel="icon" type="image/png" sizes="512x512" href="/site-icon.png"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
  <script type="application/ld+json" set:html={json}/>
 </head>
 <body><a class="skip-link" href="#main-content">Skip to content</a><Header/><main id="main-content"><slot/></main><Footer/></body>
</html>
