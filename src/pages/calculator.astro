---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
---
<Base title="Break 90 Score Calculator | Break 90 Golf" description="Find potential scoring opportunities from penalties, three-putts and wasted short-game strokes."><section class="top dark-section"><div class="container"><div class="eyebrow lime">FREE INTERACTIVE GOLF TOOL</div><h1>FIND YOUR<br/><span class="lime">MISSING STROKES.</span></h1><p>Enter a typical round. We'll highlight where a few cleaner decisions could make a difference.</p></div></section><section class="section"><div class="container tool"><div class="inputs"><h2>YOUR ROUND.</h2><p class="muted">Use your most recent 18-hole round, or a typical score.</p><label for="score">18-hole score <strong id="score-v">98</strong></label><input id="score" type="range" min="72" max="125" value="98"/><label for="penalties">Penalty strokes <strong id="penalties-v">3</strong></label><input id="penalties" type="range" min="0" max="12" value="3"/><label for="putts">Three-putts <strong id="putts-v">4</strong></label><input id="putts" type="range" min="0" max="12" value="4"/><label for="short">Avoidable short-game strokes <strong id="short-v">3</strong></label><input id="short" type="range" min="0" max="12" value="3"/><p class="note">Avoidable short-game strokes are estimated extra shots from duffed chips, failed escapes and similar mistakes. Don't count the same stroke in multiple categories.</p></div><div class="results"><div class="eyebrow">ILLUSTRATIVE IMPROVEMENT PATH</div><div class="score-row"><div><span>YOUR SCORE</span><strong id="current">98</strong></div><div class="arrow">→</div><div><span>POTENTIAL SCORE</span><strong class="lime" id="potential">92</strong></div></div><div class="saved"><span>POTENTIAL STROKES SAVED</span><strong id="saved">−6</strong></div><div class="meter"><div id="bar"></div></div><h3 id="result-heading">A FEW CLEANER HOLES.</h3><p id="result-copy">Focus on preventing penalty strokes and avoiding three-putts. Small improvements add up.</p><div class="breakdown" id="breakdown"></div><button class="btn" id="download" type="button">DOWNLOAD PRACTICE CHECKLIST ↓</button><p class="note">This is a planning exercise, not a guaranteed score prediction. We cap hypothetical savings at two per category.</p></div></div></section><Newsletter/></Base>
<style>.top{padding:75px 0}.top h1{font-size:clamp(4rem,9vw,8rem);margin:20px 0}.top p{max-width:620px;line-height:1.7;color:#b5c0b6}.tool{display:grid;grid-template-columns:1fr 1fr;gap:40px}.inputs,.results{padding:34px;background:white;border:1px solid #e0e6db}.inputs h2{margin-bottom:12px}.inputs label{display:flex;justify-content:space-between;margin:26px 0 12px;font-size:.86rem;font-weight:800}.inputs label strong{font-size:1.2rem}.inputs input{width:100%;accent-color:#84b900}.results{background:#141b17;color:white}.score-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:38px 0}.score-row>div:not(.arrow){display:flex;flex-direction:column}.score-row span,.saved span{font-size:.67rem;letter-spacing:.09em;font-weight:800;color:#b1bcb2}.score-row strong{font-family:'Barlow Condensed',sans-serif;font-size:clamp(4.5rem,8vw,7rem);line-height:1.1}.arrow{font-size:2rem;color:#c7ff35}.saved{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid #48524a;padding-top:20px}.saved strong{font-size:2rem;color:#c7ff35}.meter{height:10px;background:#3e493f;margin:18px 0 35px}.meter div{height:100%;background:#c7ff35;transition:width .2s}.results h3{margin-bottom:10px}.results p{color:#b7c2b9;line-height:1.65}.breakdown{display:grid;gap:10px;margin:25px 0}.breakdown div{display:flex;justify-content:space-between;border-bottom:1px solid #48524a;padding-bottom:10px;font-size:.84rem}.results .note{font-size:.7rem;margin-top:20px}@media(max-width:850px){.tool{grid-template-columns:1fr}.inputs,.results{padding:22px}}</style>
<script>
const ids=['score','penalties','putts','short'] as const;const get=(id:string)=>Number((document.getElementById(id) as HTMLInputElement).value);const write=(id:string,v:string)=>{const e=document.getElementById(id);if(e)e.textContent=v};function update(){ids.forEach(id=>write(id+'-v',String(get(id))));const score=get('score');const values=[Math.min(2,get('penalties')),Math.min(2,get('putts')),Math.min(2,get('short'))];const total=values.reduce((a,b)=>a+b,0);const potential=score-total;write('current',String(score));write('potential',String(potential));write('saved','−'+total);write('result-heading',potential<=89?'THE 80s ARE IN SIGHT.':'KEEP CUTTING THE BIG NUMBERS.');write('result-copy',potential<=89?'This hypothetical path reaches 89 or better. Choose one category to practice first.':`This path gets you to ${potential}. You would need ${potential-89} more strokes saved to reach 89.`);write('breakdown','');const box=document.getElementById('breakdown')!;['Penalties','Three-putts','Short game'].forEach((label,i)=>{const row=document.createElement('div');const name=document.createElement('span');name.textContent=label;const value=document.createElement('strong');value.textContent='−'+values[i];row.append(name,value);box.append(row)});(document.getElementById('bar') as HTMLElement).style.width=Math.min(100,total/Math.max(1,score-89)*100)+'%'}ids.forEach(id=>document.getElementById(id)?.addEventListener('input',update));update();document.getElementById('download')?.addEventListener('click',()=>{const rows=['BREAK 90 GOLF - PRACTICE CHECKLIST','',`Starting score: ${get('score')}`,`Penalties: ${get('penalties')}`,`Three-putts: ${get('putts')}`,`Avoidable short-game strokes: ${get('short')}`,'','PRACTICE THIS WEEK','[ ] Play 9 holes with a conservative tee-shot target','[ ] Hit 20 lag putts, aiming to finish inside 3 feet','[ ] Hit 20 chips to a safe landing spot','[ ] Track penalty strokes and three-putts in your next round','','Break 90 Golf | Less thinking. Better golf.'];const blob=new Blob([rows.join('\n')],{type:'text/plain;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='break90-practice-checklist.txt';a.click();URL.revokeObjectURL(url)});
</script>
