---
import Base from '../../layouts/Base.astro';
import {categories,categoryFor,editions,publishedProducts} from '../../lib/daily-finds';
const latest=editions[0];
---
<Base title="Daily Golf Finds: Golf Gear & Practice Tools | Break 90 Golf" description="Discover useful golf training aids, putting tools, rangefinders, launch monitors and accessories. Browse fresh daily picks and golf gear categories.">
<section class="hero"><div class="container"><div class="eyebrow lime">BREAK 90 / THE GEAR LOCKER</div><h1>DAILY GOLF<br/><span class="lime">FINDS.</span></h1><p>Five practical golf finds each day, plus a growing library of gear for everyday golfers.</p></div></section>
<section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">FIND WHAT FITS YOUR GAME</div><h2>SHOP BY CATEGORY.</h2></div></div><div class="categories">{categories.map(c=><a href={`/daily-finds/category/${c.slug}/`} class="category"><strong>{c.name} ↗</strong><span>{c.description}</span><small>{publishedProducts.filter(p=>categoryFor(p).slug===c.slug).length} finds</small></a>)}</div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">LATEST EDITION</div><h2>{latest ? new Date(latest.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'}) : 'FIRST EDITION COMING SOON'}</h2></div></div>{latest ? <div class="finds">{latest.products.map(p=><article class="find"><img src={p.image} alt={p.imageAlt} loading="lazy" width="600" height="400"/><div class="copy"><a class="eyebrow" href={`/daily-finds/category/${categoryFor(p).slug}/`}>{categoryFor(p).name}</a><h3>{p.name}</h3><p>{p.description}</p><a class="btn dark" href={p.url} target="_blank" rel="sponsored nofollow noopener noreferrer">CHECK ON AMAZON ↗</a></div></article>)}</div> : <p>Our first picks are being prepared.</p>}</div></section>
<section class="section"><div class="container"><h2>PREVIOUS FINDS</h2><div class="archive">{editions.slice(1).map(e=><details><summary>{new Date(e.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})} — Five golf finds</summary><ul>{e.products.map(p=><li><a href={p.url} rel="sponsored nofollow noopener noreferrer" target="_blank">{p.name} ↗</a> · <a href={`/daily-finds/category/${categoryFor(p).slug}/`}>{categoryFor(p).name}</a></li>)}</ul></details>)}</div><p>As an Amazon Associate, Break 90 Golf earns from qualifying purchases. <a href="/disclosure/">Read our affiliate disclosure.</a></p></div></section>
</Base>
<style>
.hero{background:#141b17;color:white;padding:76px 0}.hero h1{font-size:clamp(4rem,9vw,8rem);line-height:.92;margin:20px 0}.hero p{max-width:600px;color:#c4cdc4}.categories,.finds{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.category,.find{background:white;border:1px solid #dce3da}.category{padding:24px;display:flex;flex-direction:column;gap:10px}.category strong{font-size:1.25rem}.category span,.category small{color:#526154}.find{overflow:hidden}.find img{width:100%;aspect-ratio:3/2;object-fit:cover}.copy{padding:24px}.copy p{line-height:1.6;color:#526154}.archive details{padding:16px;border-bottom:1px solid #dce3da}.archive summary{cursor:pointer;font-weight:700}@media(max-width:700px){.categories,.finds{grid-template-columns:1fr}}
</style>
