---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {getCollection} from 'astro:content';
const all=await getCollection('articles');
const order=['break-90-golf-scoring-math-find-lost-strokes','how-to-break-90-without-changing-your-swing','why-bogey-golf-is-good-golf','should-you-hit-driver-on-every-par-four','stop-three-putting','30-minute-practice-plan','simple-grip-adjustment-for-a-slice'];
const articles=order.map(id=>all.find(a=>a.id===id)!);
---
<Base title="How to Break 90 in Golf: Start with a Simple Scoring Plan" description="Start your plan to break 90 with scoring basics, smarter tee shots, lag-putting practice and a focused 30-minute routine for everyday golfers.">
 <section class="page-heading dark-section"><div class="container"><div class="eyebrow lime">START HERE</div><h1>YOUR PLAN<br/><span class="lime">FOR THE 80s.</span></h1><p>Start with the shots you already have. Choose one scoring task, practice it with a clear target and track what happens on the course.</p><a class="btn" href="/#break-90-math">SEE THE MATH OF 89 ↗</a></div></section>

 <section class="section reading"><div class="container"><h2>Build your playbook.</h2><div class="grid3">{articles.map(a=><ArticleCard article={a}/>)}</div></div></section>
</Base>
<style>.reading{background:#eaf0e3}</style>
