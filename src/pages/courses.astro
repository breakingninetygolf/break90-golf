---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {getCollection} from 'astro:content';
const articles=await getCollection('articles');
const states=[{slug:'wisconsin',name:'Wisconsin',detail:'Compare shoreline and dunes destinations with municipal values and The Bog in our premium-value selection.'},{slug:'georgia',name:'Georgia',detail:'Explore coastal and mountain resort golf alongside state-park values, with guest-access rules clearly identified.'},{slug:'michigan',name:'Michigan',detail:'Compare Lake Michigan and Upper Peninsula destination rounds with local value picks, including Scott Lake and Glenkerry.'},{slug:'california',name:'California',detail:'Plan coastal, municipal and desert golf with visitor prices and booking details separated from local discounts.'},{slug:'new-york',name:'New York',detail:'Explore Bethpage, Upstate resorts and state-park or county courses, including seasonal price differences.'},{slug:'florida',name:'Florida',detail:'Compare destination courses with municipal and walking options, plus dated visitor rates and access notes.'}];
const schema=[{'@type':'CollectionPage',name:'Public Golf Course Guides by State',url:new URL('/courses/',Astro.site).href,description:'Destination and value guides for Wisconsin, Georgia, Michigan, California, New York and Florida.'}];
---
<Base title="Best Public Golf Courses by State: Top Picks & Value Guides" description="Compare public golf courses in Wisconsin, Georgia, Michigan, California, New York and Florida, with visitor prices, booking advice and separate best-value guides." structuredData={schema}>
 <section class="page-heading dark-section"><div class="container"><div class="eyebrow lime">PUBLIC GOLF / PLAN YOUR NEXT ROUND</div><h1>FIND YOUR<br/><span class="lime">NEXT COURSE.</span></h1><p>Two ways to plan each state: standout public courses when price is secondary, and courses worth playing for the money.</p><nav class="hub-links" aria-label="Choose a state">{states.map(s=><a class="btn outline" href={`#${s.slug}`}>{s.name}</a>)}</nav></div></section>
 {states.map(s=><section class="section state-section" id={s.slug}><div class="container"><div class="section-head"><div><div class="eyebrow">STATE GUIDE</div><h2>{s.name}</h2></div><p>{s.detail}</p></div><div class="state-grid">{['top-public-golf-courses-','best-value-public-golf-courses-'].map(prefix=>articles.find(a=>a.id===prefix+s.slug)).filter(Boolean).map(a=><ArticleCard article={a!}/>)}</div></div></section>)}
 <section class="section"><div class="container prose"><h2>Compare the complete round</h2><p>Check the date, visitor category, cart charge and reservation fee before comparing two prices. Our guides link to official operators and identify live quotes when a reliable flat rate is unavailable.</p><p>Course lists are editorial shortlists based on research, not firsthand condition inspections. Check maintenance and access before traveling. <a href="/about/">Read how we prepare our guides</a>.</p></div></section>
</Base>
<style>.state-section{scroll-margin-top:80px}.state-section:nth-of-type(odd){background:#eaf0e3}.state-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.section-head p{max-width:480px;line-height:1.7;color:#526157}.section-head h2{margin:15px 0 0}@media(max-width:650px){.state-grid{grid-template-columns:1fr}}</style>
