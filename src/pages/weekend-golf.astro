---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {getCollection} from 'astro:content';
const previewSlug='fedexcup-fall-finale-preview-2026';
const editions=(await getCollection('articles')).filter(a=>a.data.category==='Tour News').sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const preview=editions.find(a=>a.id===previewSlug);
const roundups=editions.filter(a=>a.id!==previewSlug);
---
<Base title="Weekend Golf Roundups: Friday Recaps & Saturday Storylines" description="Break 90 Golf's dated Friday tournament recaps: professional golf leaders, unfinished rounds and what to watch over the weekend.">
<section class="page-heading dark-section"><div class="container"><div class="eyebrow lime">BREAK 90 / WEEKEND WATCH</div><h1>THE WEEKEND.<br/><span class="lime">IN PLAY.</span></h1><p>Tournament recaps, the stories behind the scores, and previews of what comes next. Each edition states its scoring cutoff and links to official live results.</p></div></section>
{preview && <section class="section finale-feature" aria-labelledby="finale-title"><div class="container"><a class="finale-link" href={`/articles/${preview.id}/`}><picture><source type="image/webp" srcset={`${preview.data.image?.replace('.png','-600.webp')} 600w, ${preview.data.image?.replace('.png','.webp')} 1200w`} sizes="(max-width:800px) 100vw, 55vw"/><img src={preview.data.image} alt={preview.data.imageAlt} width="1200" height="630" fetchpriority="high"/></picture><div class="finale-copy"><div class="eyebrow">THE FALL FINALE / NOVEMBER 19–22</div><h2 id="finale-title">THE ROAD TO<br/>SEA ISLAND.</h2><p>One trophy. Several races. Your preview of the RSM Classic, the players to watch, and what 60, 100 and 125 really mean.</p><span class="btn dark">READ THE FINALE PREVIEW ↗</span></div></a></div></section>}
<section class="section"><div class="container"><h2>WEEKEND WATCH ARCHIVE.</h2><p>These are dated editorial snapshots, not live leaderboards. Read the latest edition for its stated reporting period; older editions remain available as archives.</p><div class="grid3">{roundups.map(article=><ArticleCard article={article}/>)}</div></div></section>
</Base>

<style>
.finale-feature{padding-bottom:0}.finale-link{display:grid;grid-template-columns:1.15fr 1fr;background:#eaf0e3;border:1px solid #d9e1d2;align-items:center}.finale-link picture,.finale-link img{display:block;width:100%;height:auto}.finale-copy{padding:35px}.finale-copy h2{font-size:clamp(2.3rem,4.5vw,4rem);line-height:1.03;margin:20px 0}.finale-copy p{line-height:1.7;margin-bottom:25px}.finale-link:hover{border-color:#749b27}.finale-copy .btn{font-size:.8rem}@media(max-width:800px){.finale-link{grid-template-columns:1fr}.finale-copy{padding:26px}}
</style>
