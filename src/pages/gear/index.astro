---
import Base from '../../layouts/Base.astro';import products from '../../data/products.json';
---
<Base title="Useful Golf Gear | Break 90 Golf" description="Straightforward equipment categories and golf gear ideas without unnecessary hype."><section class="section dark-section"><div class="container"><div class="eyebrow lime">THE GEAR LOCKER</div><h1>BUY SMART.<br/><span class="lime">PLAY MORE.</span></h1><p>Useful equipment categories for everyday golfers. No miracle fixes or fake product tests.</p></div></section><section class="section"><div class="container"><p class="notice">Affiliate disclosure: Some future links may earn us a commission at no extra cost to you. Product links are added only after the site owner approves them. See our <a href="/disclosure/">full disclosure</a>.</p><div class="grid3">{products.map(p=><div class="card"><span class="eyebrow muted">{p.category}</span><h3>{p.name}</h3><p>{p.description}</p><p><strong>Why it matters:</strong> {p.why}</p><div class="bottom">{p.url ? <a href={p.url} target="_blank" rel="nofollow sponsored noopener noreferrer" class="btn dark">VIEW PRODUCT ↗</a> : <span class="pending">RECOMMENDATIONS COMING SOON</span>}</div></div>)}</div></div></section></Base>
<style>.notice{background:#e8f7c6;padding:18px;margin-bottom:30px;line-height:1.6}.notice a{text-decoration:underline}.pending{font-size:.73rem;color:#687169}</style>
