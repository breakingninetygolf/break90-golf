---
import Base from '../../layouts/Base.astro';import products from '../../data/products.json';
import ArticleCard from '../../components/ArticleCard.astro';
import {getCollection} from 'astro:content';
import {getGearAndBooksArticles} from '../../lib/gear-articles';
const gearArticles=getGearAndBooksArticles(await getCollection('articles'));
const groups=[
 {id:'putting',label:'Putting & Short Game',test:/putt|short.game|setup|aim/i},
 {id:'practice',label:'Practice & Simulators',test:/home practice|home simulation|swing practice/i},
 {id:'tech',label:'Launch Monitors & GPS',test:/launch monitor|distance|gps|audio/i},
 {id:'balls',label:'Golf Balls',test:/golf balls/i},
 {id:'accessories',label:'Bags & Accessories',test:/bag|cart|golf bags/i}
];
const groupFor=(p:typeof products[number])=>groups.find(g=>g.test.test(p.category))?.id||'accessories';
const catalog=products.map((p,index)=>({...p,group:groupFor(p),order:index}));
---
<Base title="Useful Golf Gear | Break 90 Golf" description="Explore launch monitors, rangefinders, putting tools, hitting mats, golf balls and bag essentials with direct Amazon affiliate product links."><section class="section dark-section"><div class="container"><div class="eyebrow lime">THE GEAR LOCKER</div><h1>BUY SMART.<br/><span class="lime">PLAY MORE.</span></h1><p>Useful equipment for everyday golfers—from launch monitors and rangefinders to putting tools and bag essentials.</p></div></section><section class="section"><div class="container"><div class="gear-tools"><div class="eyebrow">BROWSE THE GEAR LOCKER</div><div class="gear-filters" role="group" aria-label="Filter gear by category"><button type="button" class="gear-filter active" data-filter="all" aria-pressed="true">ALL GEAR</button>{groups.map(g=><button type="button" class="gear-filter" data-filter={g.id} aria-pressed="false">{g.label}</button>)}</div><label class="gear-search-label" for="gear-search">SEARCH PRODUCTS</label><input id="gear-search" type="search" placeholder="Search golf gear…" autocomplete="off"/><p class="gear-count" id="gear-count" aria-live="polite">{products.length} products</p></div><div class="gear-grid" id="gear-grid">{catalog.map((p, index)=><article data-category={p.group} data-search={`${p.name} ${p.description} ${p.category}`.toLowerCase()} class="card gear-card" aria-labelledby={`gear-${p.id}`}><img class="gear-image" src={p.image} srcset={`${p.image.replace('.webp', '-600.webp')} 600w, ${p.image} 1200w`} sizes="(max-width: 700px) calc(100vw - 34px), (max-width: 1220px) calc((100vw - 64px) / 2), 578px" alt={p.imageAlt} width="1200" height="800" loading={index < 2 ? 'eager' : 'lazy'} decoding="async"/><div class="gear-copy"><span class="eyebrow muted">{p.category}</span><h3 id={`gear-${p.id}`}>{p.name}</h3><p>{p.description}</p><div class="bottom">{p.url ? <a href={p.url} target="_blank" rel="nofollow sponsored noopener noreferrer" class="btn dark">CHECK ON AMAZON ↗</a> : <span class="pending">RECOMMENDATIONS COMING SOON</span>}</div></div></article>)}</div></div></section><section class="section gear-reading" id="gear-books" aria-labelledby="gear-books-heading"><div class="container"><div class="section-head"><div><div class="eyebrow">THE PLAYBOOK</div><h2 id="gear-books-heading">GEAR &amp; BOOKS</h2></div><a class="btn dark" href="/articles/#gear">BROWSE THE PLAYBOOK ↗</a></div><p class="reading-intro">Buying guides, practice tools and golf books to help you choose what fits your game.</p><div class="grid3">{gearArticles.map(article=><ArticleCard article={article}/>)}</div></div></section><section class="section gear-notes" id="gear-notes" aria-label="Shopping notes"><div class="container"><p>Shopping buttons open specific Amazon product listings. Check the model, seller, current price and availability before purchasing. Read our <a href="/articles/golf-practice-tools-for-breaking-90/">practice tools guide</a> for drills, limitations and free alternatives.</p><p><strong>Building a home practice setup?</strong> Read our <a href="/articles/launch-monitors-rapsodo-mlm2pro-guide/">Rapsodo MLM2PRO launch monitor guide</a>, including Garmin R10 and Mevo Gen2 alternatives, room requirements and direct product links.</p><p><strong>Shopping for a golfer?</strong> Browse our <a href="/articles/best-christmas-golf-gifts-for-dad/">Christmas golf gift ideas for Dad</a>, from useful smaller gifts to a serious home-practice setup.</p></div></section></Base>
<style>.gear-notes{padding-top:48px;padding-bottom:48px}.gear-notes p{line-height:1.7}.gear-notes .image-note{margin-bottom:0}.gear-reading{background:#eaf0e3;scroll-margin-top:90px}.gear-reading h2{font-size:clamp(2.4rem,4vw,3.7rem);margin:12px 0 0}.reading-intro{max-width:720px;line-height:1.65;margin-bottom:30px}.gear-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;margin-top:32px}.gear-card{padding:0;overflow:hidden;min-width:0}.gear-image{display:block;width:100%;height:auto;aspect-ratio:3/2;background:#141b17}.gear-copy{padding:26px;display:flex;flex-direction:column;flex:1}.gear-copy h3{font-size:1.9rem}.gear-copy .bottom{margin-top:auto}.image-note{margin-top:24px}@media(max-width:700px){.gear-grid{grid-template-columns:1fr;gap:24px}.gear-copy{padding:22px}.gear-copy h3{font-size:1.75rem}}.notice{background:#e8f7c6;padding:18px;margin-bottom:30px;line-height:1.6}.notice a{text-decoration:underline}.pending{font-size:.73rem;color:#687169}.gear-tools{margin-top:28px}.gear-filters{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0 24px}.gear-filter{background:#fff;border:1px solid #b9c6b5;padding:11px 16px;font-weight:800;cursor:pointer;color:#141b17}.gear-filter:hover,.gear-filter.active{background:#141b17;color:#c7ff35;border-color:#141b17}.gear-search-label{display:block;font-size:.76rem;font-weight:800;letter-spacing:.08em;margin-bottom:8px}#gear-search{display:block;width:100%;max-width:440px;padding:14px 16px;border:1px solid #9fac9e;font:inherit;background:white}.gear-count{color:#536353;font-size:.9rem}.gear-card[hidden]{display:none!important}@media(max-width:700px){.gear-filter{font-size:.8rem;padding:10px 12px}}</style>
<script>
const filters=[...document.querySelectorAll<HTMLButtonElement>('.gear-filter')];
const search=document.querySelector<HTMLInputElement>('#gear-search');
const cards=[...document.querySelectorAll<HTMLElement>('#gear-grid .gear-card')];
const count=document.querySelector<HTMLElement>('#gear-count');
let selected='all';
function update(){
 const q=(search?.value||'').trim().toLowerCase();let visible=0;
 for(const card of cards){const show=(selected==='all'||card.dataset.category===selected)&&(!q||(card.dataset.search||'').includes(q));card.hidden=!show;if(show)visible++}
 if(count)count.textContent=visible+' '+(visible===1?'product':'products');
}
filters.forEach(button=>button.addEventListener('click',()=>{selected=button.dataset.filter||'all';filters.forEach(b=>{const active=b===button;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))});update()}));
search?.addEventListener('input',update);
</script>
