---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
const all=await getCollection('articles');
const articles=['how-to-break-90-without-changing-your-swing','best-value-public-golf-courses-michigan','launch-monitors-rapsodo-mlm2pro-guide'].map(id=>all.find(a=>a.id===id)!);
---
<Base><section class="hero"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow lime">GOLF FOR THE REST OF US.</div><h1>BREAK 90.<br/>PLAY<br/><span>SMARTER.</span></h1><p>Build your plan to break 90. Smarter decisions, fewer wasted strokes, and golf advice that actually makes sense on a Saturday morning.</p><div class="actions"><a class="btn" href="/calculator/">FIND YOUR MISSING STROKES ↗</a><a class="btn outline" href="/articles/">READ THE PLAYBOOK →</a><a class="btn outline" href="/courses/">PUBLIC COURSE GUIDES →</a></div><div class="hero-foot">NO SWING OVERHAUL REQUIRED. &nbsp; / &nbsp; JUST BETTER GOLF.</div></div><div class="hero-graphic" aria-label="Illustrated scorecard showing 89 strokes"><div class="rings"></div><div class="graphic-top">THE ONLY NUMBER THAT MATTERS</div><div class="big89">89<span>.</span></div><div class="graphic-bottom">IT'S CLOSER THAN YOU THINK ↗</div></div></div></section><section class="stripe"><div class="container stripe-inner"><span>LESS TROUBLE.</span><span>MORE BOGEYS.</span><span>BETTER SCORES.</span></div></section><section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">THE GAME PLAN</div><h2>PLAY SMARTER.<br/>SCORE LOWER.</h2></div><p class="section-intro">You don't need to hit every fairway or stick every approach. You need a plan for the shots that actually cost you strokes.</p></div><div class="grid3"><a class="feature" href="/calculator/"><div class="num">01 / THE TOOL</div><div class="feature-mark">−9</div><h3>FIND THE LEAKS</h3><p>See where your score is getting away from you, then make a smarter practice plan.</p><div class="feature-bottom">OPEN SCORE CALCULATOR ↗</div></a><a class="feature" href="/articles/"><div class="num">02 / THE PLAYBOOK</div><div class="feature-mark">↗</div><h3>KEEP IT SIMPLE</h3><p>Real-world tips for tee shots, approaches, short game and course management.</p><div class="feature-bottom">READ GOLF ARTICLES ↗</div></a><a class="feature" href="/gear/"><div class="num">03 / THE GEAR</div><div class="feature-mark">◎</div><h3>BUY LESS. PLAY MORE.</h3><p>Useful equipment ideas, minus the hype and unnecessary upgrades.</p><div class="feature-bottom">EXPLORE THE GEAR ↗</div></a></div></div></section><section class="quote"><div class="container"><div class="eyebrow lime">THE BREAK 90 PHILOSOPHY</div><h2>BOGEY ISN'T<br/>THE ENEMY.<br/><span class="lime">BIG NUMBERS ARE.</span></h2><p>A round of 17 bogeys and one par is 89 on a par-72 course. You don't need heroic golf. You need fewer disasters.</p><a class="btn" href="/articles/why-bogey-golf-is-good-golf/">LEARN THE STRATEGY ↗</a></div></section><section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">FRESH FROM THE PLAYBOOK</div><h2>GOOD ADVICE.<br/>NO FLUFF.</h2></div><a class="btn dark" href="/articles/">ALL ARTICLES ↗</a></div><div class="grid3">{articles.map(article=><ArticleCard article={article}/>)}</div></div></section><Newsletter/></Base>
<style>.hero{background:#141b17;color:white;overflow:hidden}.hero-grid{min-height:670px;display:grid;grid-template-columns:1.12fr .88fr;align-items:stretch}.hero-copy{padding:96px 35px 50px 0;display:flex;flex-direction:column;align-items:start}.hero h1{margin:30px 0 25px}.hero h1 span{color:#c7ff35}.hero p{font-size:1.1rem;line-height:1.65;color:#c4cdc4;max-width:520px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:18px 0 45px}.hero-foot{font-size:.68rem;letter-spacing:.12em;font-weight:800;color:#8b968d;margin-top:auto}.hero-graphic{background:#c7ff35;color:#141b17;position:relative;display:flex;flex-direction:column;justify-content:space-between;align-items:center;padding:36px;isolation:isolate;overflow:hidden}.rings{position:absolute;border:2px solid #111714;border-radius:50%;width:520px;height:520px;top:50%;left:50%;transform:translate(-50%,-50%);opacity:.15;z-index:-1;box-shadow:0 0 0 75px #c7ff35,0 0 0 77px #111714,0 0 0 150px #c7ff35,0 0 0 152px #111714}.graphic-top,.graphic-bottom{font-size:.75rem;font-weight:900;letter-spacing:.14em;text-align:center}.big89{font-family:'Barlow Condensed',sans-serif;font-size:clamp(12rem,25vw,25rem);font-weight:900;letter-spacing:-.09em;line-height:1}.big89 span{font-size:.5em}.stripe{background:#c7ff35}.stripe-inner{display:flex;justify-content:space-between;gap:20px;padding:19px 0;font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.35rem;letter-spacing:.05em}.section-intro{max-width:360px;color:#69736b;line-height:1.7}.feature{background:white;border:1px solid #e1e5de;padding:26px;min-height:340px;display:flex;flex-direction:column}.feature:hover{background:#edfad4}.feature .num{font-size:.75rem;font-weight:800;letter-spacing:.1em}.feature-mark{font-family:'Barlow Condensed',sans-serif;font-size:6.5rem;font-weight:900;line-height:1.2;margin-top:15px}.feature h3{margin:0 0 8px}.feature p{color:#657168;line-height:1.6}.feature-bottom{margin-top:auto;padding-top:20px;font-size:.76rem;font-weight:800}.quote{background:#141b17;color:white;padding:100px 0}.quote h2{font-size:clamp(4rem,9vw,8rem);margin:20px 0}.quote p{max-width:530px;line-height:1.7;color:#b5c0b6;margin-bottom:30px}@media(max-width:800px){.hero-grid{grid-template-columns:1fr}.hero-copy{padding:65px 0 45px}.hero-graphic{min-height:360px}.big89{font-size:14rem}.stripe-inner{font-size:.85rem}.quote{padding:70px 0}}</style>
