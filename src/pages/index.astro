---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
const all=await getCollection('articles');
const weekend=all.filter(a=>a.data.category==='Tour News').sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf())[0];
const articles=['break-90-golf-scoring-math-find-lost-strokes','best-christmas-golf-gifts-for-dad','launch-monitors-rapsodo-mlm2pro-guide'].map(id=>all.find(a=>a.id===id)!);
---
<Base><section class="hero"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow lime">GOLF FOR THE REST OF US.</div><h1>BREAK 90.<br/>PLAY<br/><span>SMARTER.</span></h1><p>Build your plan to break 90. Smarter decisions, fewer wasted strokes, and golf advice that actually makes sense on a Saturday morning.</p><div class="actions"><a class="btn" href="#break-90-math">SEE THE MATH OF 89 ↓</a><a class="btn outline" href="/articles/">READ THE PLAYBOOK →</a><a class="btn outline" href="/courses/">PUBLIC COURSE GUIDES →</a></div><div class="hero-foot">NO SWING OVERHAUL REQUIRED. &nbsp; / &nbsp; JUST BETTER GOLF.</div></div><div class="hero-graphic" aria-label="Illustrated scorecard showing 89 strokes"><div class="rings"></div><div class="graphic-top">THE ONLY NUMBER THAT MATTERS</div><div class="big89">89<span>.</span></div><div class="graphic-bottom">IT'S CLOSER THAN YOU THINK ↗</div></div></div></section><section class="stripe"><div class="container stripe-inner"><span>LESS TROUBLE.</span><span>MORE BOGEYS.</span><span>BETTER SCORES.</span></div></section><section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">THE GAME PLAN</div><h2>PLAY SMARTER.<br/>SCORE LOWER.</h2></div><p class="section-intro">You don't need to hit every fairway or stick every approach. You need a plan for the shots that actually cost you strokes.</p></div><div class="grid3"><a class="feature" href="#break-90-math"><div class="num">01 / THE MATH</div><div class="feature-mark">+17</div><h3>BOGEY HAS A PLACE</h3><p>On a par-72 course, 17 bogeys and one par add up to 89. Start with a manageable target.</p><div class="feature-bottom">SEE HOW 89 ADDS UP ↓</div></a><a class="feature" href="/articles/"><div class="num">02 / THE PLAYBOOK</div><div class="feature-mark">↗</div><h3>KEEP IT SIMPLE</h3><p>Real-world tips for tee shots, approaches, short game and course management.</p><div class="feature-bottom">READ GOLF ARTICLES ↗</div></a><a class="feature" href="/gear/"><div class="num">03 / THE GEAR</div><div class="feature-mark">◎</div><h3>BUY LESS. PLAY MORE.</h3><p>Useful equipment ideas, minus the hype and unnecessary upgrades.</p><div class="feature-bottom">EXPLORE THE GEAR ↗</div></a></div></div></section><section class="quote" id="break-90-math" aria-labelledby="math-heading"><div class="container math-grid"><div><div class="eyebrow lime">THE MATH OF BREAKING 90</div><h2 id="math-heading">YOU DON'T NEED<br/>PARS EVERYWHERE.<br/><span class="lime">YOU NEED 89.</span></h2><p>On a par-72 course, bogey on every hole is 90. Turn just one of those bogeys into a par and you're in the 80s.</p><a class="btn" href="/articles/break-90-golf-scoring-math-find-lost-strokes/">FIND YOUR NEXT STROKES TO SAVE ↗</a></div><div class="math-card"><div class="eyebrow">YOUR PAR-72 SCORECARD</div><div class="math-equation"><div><strong>72</strong><span>COURSE PAR</span></div><span class="math-symbol" aria-hidden="true">+</span><div><strong>17</strong><span>OVER PAR</span></div><span class="math-symbol" aria-hidden="true">=</span><div class="math-total"><strong>89</strong><span>YOU BROKE 90</span></div></div><ul class="math-paths"><li><strong>17 bogeys + 1 par</strong><span>+17 → 89</span></li><li><strong>15 bogeys + 2 pars + 1 double</strong><span>+17 → 89</span></li></ul><p class="math-note">A double doesn't end your round. In the second example, two pars leave room for one double bogey. Keep the next decision simple.</p><p class="math-note math-footnote">These examples assume 18 holes and par 72. On a par-71 course, 18 bogeys also total 89.</p></div></div></section><section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">FRESH FROM THE PLAYBOOK</div><h2>GOOD ADVICE.<br/>NO FLUFF.</h2></div><a class="btn dark" href="/articles/">ALL ARTICLES ↗</a></div><div class="grid3">{articles.map(article=><ArticleCard article={article}/>)}</div></div></section>{weekend&&<section class="section"><div class="container"><div class="eyebrow">WEEKEND WATCH</div><h2>WHAT'S HAPPENING<br/>IN PRO GOLF.</h2><p>{weekend.data.title}</p><p>{weekend.data.description}</p><div class="actions"><a class="btn dark" href={`/articles/${weekend.id}/`}>READ THE LATEST ROUNDUP ↗</a><a class="btn" href="/weekend-golf/">ALL EDITIONS ↗</a></div></div></section>}<Newsletter/></Base>
<style>.hero{background:#141b17;color:white;overflow:hidden}.hero-grid{min-height:670px;display:grid;grid-template-columns:1.12fr .88fr;align-items:stretch}.hero-copy{padding:96px 35px 50px 0;display:flex;flex-direction:column;align-items:start}.hero h1{margin:30px 0 25px}.hero h1 span{color:#c7ff35}.hero p{font-size:1.1rem;line-height:1.65;color:#c4cdc4;max-width:520px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:18px 0 45px}.hero-foot{font-size:.68rem;letter-spacing:.12em;font-weight:800;color:#8b968d;margin-top:auto}.hero-graphic{background:#c7ff35;color:#141b17;position:relative;display:flex;flex-direction:column;justify-content:space-between;align-items:center;padding:36px;isolation:isolate;overflow:hidden}.rings{position:absolute;border:2px solid #111714;border-radius:50%;width:520px;height:520px;top:50%;left:50%;transform:translate(-50%,-50%);opacity:.15;z-index:-1;box-shadow:0 0 0 75px #c7ff35,0 0 0 77px #111714,0 0 0 150px #c7ff35,0 0 0 152px #111714}.graphic-top,.graphic-bottom{font-size:.75rem;font-weight:900;letter-spacing:.14em;text-align:center}.big89{font-family:'Barlow Condensed',sans-serif;font-size:clamp(12rem,25vw,25rem);font-weight:900;letter-spacing:-.09em;line-height:1}.big89 span{font-size:.5em}.stripe{background:#c7ff35}.stripe-inner{display:flex;justify-content:space-between;gap:20px;padding:19px 0;font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.35rem;letter-spacing:.05em}.section-intro{max-width:360px;color:#69736b;line-height:1.7}.feature{background:white;border:1px solid #e1e5de;padding:26px;min-height:340px;display:flex;flex-direction:column}.feature:hover{background:#edfad4}.feature .num{font-size:.75rem;font-weight:800;letter-spacing:.1em}.feature-mark{font-family:'Barlow Condensed',sans-serif;font-size:6.5rem;font-weight:900;line-height:1.2;margin-top:15px}.feature h3{margin:0 0 8px}.feature p{color:#657168;line-height:1.6}.feature-bottom{margin-top:auto;padding-top:20px;font-size:.76rem;font-weight:800}.quote{background:#141b17;color:white;padding:100px 0}.quote h2{font-size:clamp(3rem,5.3vw,5rem);margin:20px 0}.quote p{max-width:530px;line-height:1.7;color:#b5c0b6;margin-bottom:30px}.math-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center}.quote{scroll-margin-top:96px}.math-card{padding:30px;border:1px solid #48524a;background:#1c251e}.math-equation{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:30px 0}.math-equation>div{display:flex;flex-direction:column;align-items:center;gap:8px}.math-equation strong{font-family:"Barlow Condensed",sans-serif;font-size:clamp(3rem,5vw,5rem);line-height:1}.math-equation span{font-size:.63rem;font-weight:800;letter-spacing:.04em}.math-equation .math-symbol{font-size:1.6rem;color:#b5c0b6}.math-total{color:#c7ff35}.math-paths{list-style:none;padding:0;margin:0}.math-paths li{display:flex;justify-content:space-between;gap:14px;padding:17px 0;border-top:1px solid #48524a;font-size:.86rem;line-height:1.5}.math-paths li span{white-space:nowrap;color:#c7ff35}.quote .math-note{font-size:.86rem;line-height:1.65;margin:18px 0 0}.quote .math-footnote{font-size:.75rem;color:#96a398}@media(max-width:800px){.math-grid{grid-template-columns:1fr;gap:30px}.math-card{padding:22px}.math-equation strong{font-size:4rem}.hero-grid{grid-template-columns:1fr}.hero-copy{padding:65px 0 45px}.hero-graphic{min-height:360px}.big89{font-size:14rem}.stripe-inner{font-size:.85rem}.quote{padding:70px 0}}</style>
